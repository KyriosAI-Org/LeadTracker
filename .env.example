# ----------------------------------------------------------------------------
# LeadTracker — variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env (já está no .gitignore).
# ----------------------------------------------------------------------------

# Públicas (injetadas no bundle do browser em tempo de BUILD via Vite).
# São seguras de expor — a publishable/anon key é pública por design.
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-anon-key-jwt"
VITE_SUPABASE_PROJECT_ID="seu-project-id"

# Server-side (lidas em runtime pelo SSR e pelos server functions).
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sua-anon-key-jwt"

# SECRETA — service_role. Só no servidor, JAMAIS com prefixo VITE_.
# Dá acesso total ao banco (bypassa RLS). Mantenha fora do git.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx"

# Porta interna do container (Traefik aponta pra ela). Default 3000.
PORT=3000
